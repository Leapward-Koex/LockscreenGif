<Page
    x:Class="LockscreenGif.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LockscreenGif.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
    <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid MaxWidth="1000" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Prerequisites  -->
            <RowDefinition Height="*" />
            <!--  Pivot content  -->
            <RowDefinition Height="Auto" />
            <!--  Remove section  -->
            <RowDefinition Height="Auto" />
            <!--  Apply button  -->
        </Grid.RowDefinitions>

        <!--  1) Title  -->
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,12">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Lockscreen Gif" />
            <InfoBar x:Name="OperationStatus" Severity="Informational" IsOpen="False" />
        </StackPanel>

        <!--  2) Prerequisites Section  -->
        <Expander
            Grid.Row="1"
            Margin="0,0,0,16"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="PrereqWarningIcon"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        FontSize="16"
                        Foreground="{StaticResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;"
                        Visibility="Collapsed" />
                    <TextBlock Grid.Column="1" Text="Getting Started" />
                </Grid>
            </Expander.Header>
            <StackPanel Margin="0,8,0,0" Spacing="12">
                <TextBlock
                    x:Name="PrereqIntroText"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    Text="Follow these steps before using the application:"
                    TextWrapping="Wrap" />

                <!--  Step 1 warning  -->
                <InfoBar
                    x:Name="LockscreenModeWarning"
                    Title="Lock screen must be set to Picture"
                    Margin="0,0,0,4"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning">
                    <InfoBar.Message>
                        Your current lock screen mode is not compatible (Slideshow/Spotlight). Switch to 'Picture' in Windows Settings.
                    </InfoBar.Message>
                </InfoBar>

                <!--  Step 1  -->
                <Grid x:Name="PrereqStep1Root">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="PrereqStep1Badge"
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentFillColorDefaultBrush}"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
                            Text="1" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            x:Name="PrereqStep1Title"
                            FontWeight="SemiBold"
                            Text="Set a default lockscreen in Windows Settings (Only required for the first time)" />
                        <TextBlock
                            x:Name="PrereqStep1Body"
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="Open Windows Settings → Personalization → Lock screen, change lockscreen type to 'Picture' and browse to select an initial image (actual image in unimportant, but it should be a picture on your computer)."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  Step 2  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentFillColorDefaultBrush}"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
                            Text="1" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Generate the required image cache for your screens" />
                        <TextBlock
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="Lock your screen once to generate the required image cache for your screens, then unlock and proceed with the next step."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  Step 3  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentFillColorDefaultBrush}"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
                            Text="2" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Choose your GIF source" />
                        <TextBlock
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="Either choose a video to convert to a GIF or select an existing GIF file from your device."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  Step 4  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentFillColorDefaultBrush}"
                        CornerRadius="16">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextOnAccentFillColorPrimaryBrush}"
                            Text="3" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Apply and enjoy" />
                        <TextBlock
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="Click the Apply button to set your animated GIF as your lockscreen."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  Resetting  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Resetting back to a regular lockscreen if you want to remove the GIF" />
                        <TextBlock
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="Click the 'Remove' button in the app to reset to the image you previously selected as your lockscreen."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Expander>

        <ScrollView
            Grid.Row="2"
            IsTabStop="True"
            VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1000" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  GIF preview  -->
                    <RowDefinition Height="Auto" />
                    <!--  Pivot content  -->
                </Grid.RowDefinitions>
                <!--  GIF preview  -->
                <Border
                    Grid.Row="0"
                    Width="533"
                    Height="300"
                    Background="{StaticResource SystemFillColorAttentionBackground}"
                    BorderBrush="{StaticResource SystemAltLowColor}"
                    BorderThickness="4"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Image x:Name="currentImage" Stretch="Fill" />
                </Border>

                <!--  2) Pivot: two tabs, one for GIF, one for Video  -->
                <winui:Pivot Grid.Row="1">
                    <!--  2a) Convert Video  -->
                    <winui:PivotItem Header="Video to GIF">
                        <StackPanel Spacing="16">

                            <!--  Browse Video panel  -->
                            <Grid
                                Padding="24"
                                Background="{StaticResource SystemFillColorNeutralBackgroundBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,24,0"
                                    Glyph="&#xE714;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="Select a video to convert" />
                                <Button
                                    Grid.Column="2"
                                    Padding="32,8"
                                    x:Name="BrowseVideoButton"
                                    Click="OpenVideoButton_click"
                                    Content="Browse Video" />
                            </Grid>

                            <Grid x:Name="VideoPreviewPanel" Visibility="Collapsed" MaxWidth="560">
                                <MediaPlayerElement x:Name="VideoPreview" AreTransportControlsEnabled="False" />
                                <Image x:Name="PreviewStill" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />
                                <Border x:Name="PreviewLoadingPanel" Visibility="Collapsed" Background="#99000000" IsHitTestVisible="False">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                        <ProgressRing x:Name="PreviewLoadingRing" Width="32" Height="32" IsActive="False" Foreground="White" />
                                        <TextBlock x:Name="PreviewLoadingText" Text="Loading frame…" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="You can keep adjusting the clip." Foreground="White" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ContentControl x:Name="TrimEditorHost" HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="TrimControlsPanel" Spacing="12" Visibility="Collapsed" SizeChanged="TrimControlsPanel_SizeChanged">
                                <Grid Margin="0,4,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Choose your clip" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="SelectionSummary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Reset trim" Click="ResetTrim_Click" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Select the full video and return the preview to its first frame" />
                                </Grid>
                                <local:VideoTimeline x:Name="TrimTimeline"
                                    InteractionStarted="Timeline_InteractionStarted"
                                    InteractionCompleted="Timeline_InteractionCompleted"
                                    FrameChanged="Timeline_FrameChanged" />
                                <Button x:Name="PlaySelectionButton" Content="Play" Click="PlaySelection_Click" MinWidth="96" HorizontalAlignment="Center"
                                        ToolTipService.ToolTip="Play or pause the selected clip. Playback loops automatically." />
                                <TextBlock x:Name="PreviewStatus" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                                <Grid x:Name="TrimBoundaryGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border x:Name="StartBoundaryCard" Padding="16" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="StartTimeHeading" Text="Start" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock x:Name="StartFrameLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBox x:Name="StartTimeTextBox" AutomationProperties.Name="Clip start time" AutomationProperties.LabeledBy="{Binding ElementName=StartTimeHeading}"
                                                LostFocus="TimeTextBox_LostFocus" KeyDown="TimeTextBox_KeyDown" PlaceholderText="Seconds or mm:ss.fff" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <RepeatButton x:Name="StartBackButton" Content="−1 frame" Tag="StartBack" Click="NudgeBoundary_Click"
                                                    AutomationProperties.Name="Move start one frame earlier" ToolTipService.ToolTip="Move start exactly one frame earlier" />
                                                <RepeatButton x:Name="StartForwardButton" Content="+1 frame" Tag="StartForward" Click="NudgeBoundary_Click"
                                                    AutomationProperties.Name="Move start one frame later" ToolTipService.ToolTip="Move start exactly one frame later" />
                                            </StackPanel>
                                            <Button Click="StartHere_Click" ToolTipService.ToolTip="Use the current preview frame as the first included frame">
                                                <TextBlock Text="Set start to current frame" TextWrapping="Wrap" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="EndBoundaryCard" Grid.Column="2" Padding="16" CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="EndTimeHeading" Text="End" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock x:Name="EndFrameLabel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBox x:Name="EndTimeTextBox" AutomationProperties.Name="Clip end time" AutomationProperties.LabeledBy="{Binding ElementName=EndTimeHeading}"
                                                ToolTipService.ToolTip="End time is just after the last included frame."
                                                LostFocus="TimeTextBox_LostFocus" KeyDown="TimeTextBox_KeyDown" PlaceholderText="Seconds or mm:ss.fff" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <RepeatButton x:Name="EndBackButton" Content="−1 frame" Tag="EndBack" Click="NudgeBoundary_Click"
                                                    AutomationProperties.Name="Move end one frame earlier" ToolTipService.ToolTip="Move end exactly one frame earlier" />
                                                <RepeatButton x:Name="EndForwardButton" Content="+1 frame" Tag="EndForward" Click="NudgeBoundary_Click"
                                                    AutomationProperties.Name="Move end one frame later" ToolTipService.ToolTip="Move end exactly one frame later" />
                                            </StackPanel>
                                            <Button Click="EndHere_Click" ToolTipService.ToolTip="Include the current preview frame as the last frame">
                                                <TextBlock Text="Set end to current frame" TextWrapping="Wrap" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TrimError" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />

                            </StackPanel>
                            </ContentControl>
                            <ContentControl x:Name="VideoSettingsHost" HorizontalContentAlignment="Stretch">
                            <StackPanel
                                x:Name="ComboSettingsStack"
                                Margin="0,16,0,0"
                                Spacing="8"
                                Visibility="Collapsed">
                                <!--  Settings row  -->
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Resolution" />
                                        <ComboBox
                                            x:Name="ComboResolution"
                                            Width="160"
                                            SelectionChanged="ComboResolution_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Frame rate" />
                                        <ComboBox
                                            x:Name="ComboFps"
                                            Width="200"
                                            SelectionChanged="ComboResolution_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>


                            </ContentControl>
                            <!--  Generate button  -->
                            <InfoBar
                                x:Name="FileSizeWarning"
                                Title="Free space requirement"
                                IsClosable="False"
                                IsOpen="False"
                                Message=""
                                Severity="Warning" />
                            <Button
                                x:Name="GenerateButton"
                                HorizontalAlignment="Right"
                                Click="GenerateButton_Click"
                                Content="Generate GIF"
                                IsEnabled="False" />
                            <ProgressBar
                                x:Name="GenerateLoading"
                                Visibility="Collapsed"
                                Value="0" />
                            <StackPanel x:Name="SaveGeneratedGifPanel" Spacing="8" Visibility="Collapsed">
                                <Button x:Name="SaveGeneratedGifButton"
                                        Click="SaveGeneratedGifButton_Click"
                                        ToolTipService.ToolTip="Save a copy of the generated GIF to a folder you choose">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                                        <TextBlock Text="Save GIF…" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Keep a copy to reuse later with Browse GIF."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                        </StackPanel>
                    </winui:PivotItem>

                    <!--  2b) Use existing GIF  -->
                    <winui:PivotItem Header="Use GIF">
                        <StackPanel Spacing="16">

                            <!--  Browse GIF panel  -->
                            <Grid
                                Padding="24"
                                Background="{StaticResource SystemFillColorNeutralBackgroundBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,24,0"
                                    Glyph="&#xE8B9;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="Select a GIF file to set as lockscreen" />
                                <Button
                                    Grid.Column="2"
                                    Padding="32,8"
                                    Click="OpenGifButton_click"
                                    Content="Browse GIF" />
                            </Grid>

                        </StackPanel>
                    </winui:PivotItem>
                </winui:Pivot>
            </Grid>
        </ScrollView>

        <!--  3) Remove Section: Clear saved animated GIFs and revert to default  -->
        <Grid
            Grid.Row="3"
            Margin="0,12,0,12"
            Padding="16"
            Background="{StaticResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="Remove Animated Lockscreen" />
                <TextBlock
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    Text="This will clear any saved animated GIFs and revert back to your existing lockscreen"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                x:Name="removeAnimatedLockscreen"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="RemoveAnimatedLockscreenButton_click"
                Content="Remove" />
        </Grid>

        <!--  4) Bottom Row: Apply button  -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">

            <!--  apply button  -->
            <Button
                x:Name="ApplyButton"
                Click="SetLockscreenButton_click"
                Content="Apply"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}" />

            <!--  help icon button  -->
            <Button
                x:Name="HelpButton"
                Width="32"
                Height="32"
                Padding="0"
                ToolTipService.Placement="Top">
                <FontIcon
                    Grid.Column="0"
                    FontSize="16"
                    Glyph="&#xE897;" />
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <StackPanel
                            MaxWidth="260"
                            Margin="8"
                            Spacing="10">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Lockscreen not showing after you apply?"
                                    TextWrapping="Wrap" />
                                <TextBlock Text="Try manually setting one in the Windows settings first, then try applying again." TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Changed your primary monitor resolution?"
                                    TextWrapping="Wrap" />
                                <TextBlock Text="If you change the screen resolution of your primary monitor, re-apply your GIF from the app for it to take effect." TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </StackPanel>
    </Grid>
    </ContentControl>
    <!-- Outside the ScrollView so loading is always visible and blocks inactive controls. -->
    <Grid x:Name="VideoLoadPanel" Visibility="Collapsed" Background="#99000000"
          KeyDown="VideoLoadPanel_KeyDown" TabFocusNavigation="Cycle">
        <Border MaxWidth="440" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="16">
                <ProgressRing x:Name="VideoLoadRing" Width="44" Height="44" IsActive="False"
                              AutomationProperties.Name="Preparing video" />
                <TextBlock Text="Preparing your video" Style="{ThemeResource SubtitleTextBlockStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="VideoLoadFileName" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Reading the video so you can select exact frames. Editing will be available when this finishes. Longer videos can take a little while."
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="VideoLoadStatus" Text="Reading video details…" TextWrapping="Wrap"
                           TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="CancelVideoLoadButton" Content="Cancel" Click="CancelVideoLoad_Click"
                        HorizontalAlignment="Center" MinWidth="120" AutomationProperties.Name="Cancel video loading" />
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Page>
