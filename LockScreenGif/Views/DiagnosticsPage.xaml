<Page
    x:Class="LockscreenGif.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LockscreenGif.ViewModels"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style x:Key="DiagnosticCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <DataTemplate x:Key="FindingHeaderTemplate" x:DataType="vm:DiagnosticFindingViewModel">
            <Grid Margin="0,4,0,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE73E;"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Visibility="{x:Bind SuccessVisibility}"
                        AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE7BA;"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Visibility="{x:Bind WarningVisibility}"
                        AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                    <FontIcon
                        FontSize="20"
                        Glyph="&#xE946;"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind InformationVisibility}"
                        AutomationProperties.Name="{x:Bind AccessibleStatus}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind StatusDescription}"
                        TextWrapping="Wrap" />
                    <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="920" Margin="24,20,24,16" Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Diagnostics" />
                    <TextBlock FontSize="16" Text="Find out what happens when your screen locks" TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Apply a GIF, lock your computer, then unlock to review the findings. Results stay in memory until you start another test or close the app. Export a report if you want to keep it."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource DiagnosticCard}">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Set up your test" />
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Source animation" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SourceDescription, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <HyperlinkButton HorizontalAlignment="Left" Padding="0" Click="ChooseSource_Click" Content="Choose or convert a GIF on Lockscreen" IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" />
                        <CheckBox
                            Content="Use the bundled reference animation"
                            IsChecked="{x:Bind ViewModel.UseReference, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="6">
                            <ToggleSwitch
                                AutomationProperties.Name="Set the lock screen through Windows before applying the GIF"
                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.UseWindowsApi, Mode=TwoWay}"
                                OffContent="Windows API step off"
                                OnContent="Windows API step on">
                                <ToggleSwitch.Header>
                                    <TextBlock Text="Set the lock screen through Windows first" TextWrapping="Wrap" />
                                </ToggleSwitch.Header>
                            </ToggleSwitch>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="If your GIF is not working, turning this on may help. Windows will set the lock-screen image before the app applies the GIF. Try enabling it and running the test again."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SetupWarningsVisibility, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SetupWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiagnosticSetupWarning">
                                        <InfoBar
                                            Margin="0,0,0,8"
                                            Title="{x:Bind Title}"
                                            IsClosable="False"
                                            IsOpen="True"
                                            Message="{x:Bind Message}"
                                            Severity="Warning" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Check setup problems again"
                                Click="Refresh_Click"
                                Content="Check again"
                                IsEnabled="{x:Bind ViewModel.CanConfigure, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Starting a test may request administrator permission once for tracing and any necessary cache access. Keep this app open throughout the test."
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="Start_Click"
                            Content="Start test and apply"
                            IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DiagnosticCard}" Visibility="{x:Bind ViewModel.SessionVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Phase, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SessionDescription, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressDescription, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.RunningVisibility, Mode=OneWay}">
                            <Button Click="Lock_Click" Content="Lock now" IsEnabled="{x:Bind ViewModel.CanLock, Mode=OneWay}" />
                            <Button Click="Stop_Click" Content="Stop test" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DiagnosticCard}" Visibility="{x:Bind ViewModel.ResultVisibility, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Findings" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticFindingViewModel">
                                <Grid Margin="0,0,0,8">
                                    <ContentPresenter
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource FindingHeaderTemplate}"
                                        Visibility="{x:Bind LeafVisibility}" />
                                    <Expander
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Header="{Binding}"
                                        HeaderTemplate="{StaticResource FindingHeaderTemplate}"
                                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                        Visibility="{x:Bind GroupVisibility}">
                                        <ItemsControl
                                            ItemsSource="{x:Bind Children}"
                                            ItemTemplate="{StaticResource FindingHeaderTemplate}" />
                                    </Expander>
                                </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <Border
            Grid.Row="1"
            MaxWidth="920"
            Margin="24,0,24,16"
            Padding="16"
            Style="{StaticResource DiagnosticCard}">
            <StackPanel Spacing="10">
                <InfoBar
                    Title="Diagnostics"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                    Severity="Informational" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="Export_Click"
                    Content="Export report"
                    IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Export the timeline, file checks, and app details as a ZIP report." />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Personal paths are redacted. Source media and screenshots are excluded. Review the report before sharing it."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Right"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind AppVersion}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
