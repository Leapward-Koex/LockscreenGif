<UserControl
    x:Class="LockscreenGif.CustomControls.VideoTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LockscreenGif.CustomControls">
    <UserControl.Resources>
        <Style x:Key="TrimHandleStyle" TargetType="local:FrameHandle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="64" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="StartHandleStyle" TargetType="local:FrameHandle" BasedOn="{StaticResource TrimHandleStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:FrameHandle">
                        <Grid Background="Transparent">
                            <Border Width="12" HorizontalAlignment="Right" CornerRadius="6,0,0,6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <Border Width="2" Height="20" CornerRadius="1"
                                        Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EndHandleStyle" TargetType="local:FrameHandle" BasedOn="{StaticResource TrimHandleStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:FrameHandle">
                        <Grid Background="Transparent">
                            <Border Width="12" HorizontalAlignment="Left" CornerRadius="0,6,6,0"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <Border Width="2" Height="20" CornerRadius="1"
                                        Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Root" Height="108" SizeChanged="Root_SizeChanged">
        <Grid x:Name="Filmstrip" Margin="32,32,32,12" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" IsHitTestVisible="False" />
        <Canvas x:Name="Track" Background="Transparent" PointerPressed="Track_PointerPressed">
            <Border x:Name="LeftShade" Canvas.Top="32" Height="64" Background="#B0000000" IsHitTestVisible="False" />
            <Border x:Name="RightShade" Canvas.Top="32" Height="64" Background="#B0000000" IsHitTestVisible="False" />
            <Border x:Name="Selection" Canvas.Top="32" Height="64" BorderThickness="2" CornerRadius="6"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
            <local:FrameHandle x:Name="StartHandle" Canvas.Top="32" Style="{StaticResource StartHandleStyle}"
                               AutomationProperties.Name="Clip start frame" ToolTipService.ToolTip="Start: drag or use arrow keys to move one frame" />
            <local:FrameHandle x:Name="EndHandle" FrameNumberOffset="0" Canvas.Top="32" Style="{StaticResource EndHandleStyle}"
                               AutomationProperties.Name="Clip end frame" ToolTipService.ToolTip="End: drag or use arrow keys to move one frame" />
            <Border x:Name="PlayheadShadow" Canvas.Top="31" Height="65" Width="4"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" IsHitTestVisible="False" />
            <Border x:Name="PlayheadLine" Canvas.Top="31" Height="65" Width="2"
                    Background="{ThemeResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" />
            <local:FrameHandle x:Name="PlayheadHandle" Width="32" Height="32" IsTabStop="True" UseSystemFocusVisuals="True"
                               AutomationProperties.Name="Preview frame" ToolTipService.ToolTip="Preview: drag or use arrow keys to step frames">
                <local:FrameHandle.Template>
                    <ControlTemplate TargetType="local:FrameHandle">
                        <Grid Background="Transparent">
                            <Path Width="14" Height="16" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                  Data="M 0,0 L 14,0 L 14,9 L 7,16 L 0,9 Z" Stretch="Fill"
                                  Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                  Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1" />
                        </Grid>
                    </ControlTemplate>
                </local:FrameHandle.Template>
            </local:FrameHandle>
        </Canvas>
    </Grid>
</UserControl>
