<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../LockScreenGif/Models/Diagnostics/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../LockScreenGif/Models/LockscreenApplyResult.cs" Link="Models/LockscreenApplyResult.cs" />
    <Compile Include="../../LockScreenGif/Services/Diagnostics/*.cs"
             Exclude="../../LockScreenGif/Services/Diagnostics/PrivilegedSessionFactory.cs;../../LockScreenGif/Services/Diagnostics/EnvironmentCollector.cs;../../LockScreenGif/Services/Diagnostics/WindowsSessionMonitor.cs"
             Link="Production/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../../LockscreenGif.Privileged.Contracts/LockscreenGif.Privileged.Contracts.csproj" /></ItemGroup>
</Project>
